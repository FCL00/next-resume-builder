# GEMINI_API_KEY: Required for Gemini AI writing assistant API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Supabase Configuration
# To connect your own Supabase project, provide your project URL and public anon key.
# If these are left blank, the application seamlessly runs in client-persisted demo mode!
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
